<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>semantic_perception</name>
  <version>0.1.0</version>
  <description>
    Open-set VLM perception nodes for LocateAnything and Grounding DINO,
    producing action-aware SemanticDetection2D messages, plus a static region
    publisher for testing. Adapted from arXiv:2310.08873.
  </description>

  <maintainer email="justinshih@gapp.nthu.edu.tw">justinshih</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>btcpp_ros2_interfaces</exec_depend>
  <!-- Model runtimes are installed by docker/sim/modules/install_* scripts,
       not through rosdep keys. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
