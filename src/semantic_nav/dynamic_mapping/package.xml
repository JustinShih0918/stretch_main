<?xml version="1.0"?>
<package format="3">
  <name>dynamic_mapping</name>
  <version>0.1.0</version>
  <description>
    Runtime dynamic occupancy-map overlay for Nav2. It preserves the SLAM
    backend map and publishes a cleaned navigation map after repeated LiDAR
    free-space evidence through configured semantic dynamic-object regions.
  </description>

  <maintainer email="justinshih@gapp.nthu.edu.tw">justinshih</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>btcpp_ros2_interfaces</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
