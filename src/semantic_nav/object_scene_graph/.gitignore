__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.hydra/
outputs/
# Generated datasets, checkpoints and external checkouts stay ignored.  Keep
# only the tiny, provenance-carrying A/B split manifests under version control.
data/*
!data/README.md
!data/splits/
# Native ASCENT's recorded 100-episode trace (gzipped, <1 MB), which compare_ascent_osg.py
# reads by default and which cannot be regenerated from the unpatched submodule.
!data/reference/
data/splits/*
!data/splits/*.json
.env
*.npz
*.pt
mobileclip_blt.ts
.vscode/
.idea/
# Local Claude Code state stays private; the repo's skills are shared.
.claude/*
!.claude/skills/
.conda-envs/
relative_work/
/assets/

# Rendered paper figures: 74 MB of PNG/PDF/SVG regenerated by scripts/render_*.py.
# The renderers are the source of truth; the output is not.
docs/figures/
# Ultralytics writes predict runs here.
runs/

# A second working copy of this repo, kept beside it to run one arm while the
# main tree runs another. Its `outputs/` is already covered by the rule above;
# this covers the rest of the checkout so `git add -A` cannot sweep it in.
#
# BEFORE RELYING ON THIS: mf5arm's source is not disposable. It is the tree that
# scores 28/53 on DualMap cross-anchor -- the result docs/CROSS_ANCHOR_REPRODUCTION.md
# could not reproduce from anything in this repository's history. Diff its src/
# and configs/ against this tree and commit the difference as a branch first.
# Once the directory is ignored, `git add` refuses it silently and the only copy
# of that code is on one machine.
/mf5arm/
