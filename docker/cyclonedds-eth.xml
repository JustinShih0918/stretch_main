<?xml version="1.0" encoding="UTF-8" ?>
<!--
  CycloneDDS configuration for the WIRED robot <-> Thor link.

  Shared by docker/vlm (Thor) and docker/deploy (robot): both bind-mount the
  repo, so this file is read from the workspace and needs no image rebuild.
  Select it with CYCLONEDDS_URI; both composes already default to it.

  Why it exists: docker/vlm/cyclonedds.xml (baked into the vlm image) uses
  autodetermine="true", which makes Cyclone pick exactly ONE interface by its
  own ranking. With Wi-Fi and Ethernet both up that choice is not stable, and
  it was landing on Wi-Fi — where a 1280x720 rgb8 frame (2.76 MB, ~663 Mbit/s
  at 30 Hz) has no chance. This file pins DDS to the wired NIC instead.

  The interface NAME differs per machine, so it comes from the environment:

      Thor    enP2p1s0   192.168.100.2   (the default below)
      robot   <its NIC>  192.168.100.1   -> set CYCLONEDDS_IFACE on the robot

  Check yours with `ip -brief addr` and export CYCLONEDDS_IFACE if it is not
  the default. A wrong name is not silent: Cyclone refuses to start and says
  "does not match an available interface".

  IMPORTANT: this pins BOTH ends to the wired subnet, and it only works if both
  ends are pinned. A machine left on autodetermine may pick its Wi-Fi NIC, and
  then the two simply never discover each other. Side effect: a laptop running
  rviz over Wi-Fi will no longer see these topics — put it on the wired subnet,
  or point that machine at docker/vlm/cyclonedds.xml instead.
-->
<CycloneDDS xmlns="https://cdds.io/config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
    <Domain Id="any">
        <General>
            <Interfaces>
                <NetworkInterface name="${CYCLONEDDS_IFACE:-enP2p1s0}" priority="default" multicast="default" />
            </Interfaces>
            <AllowMulticast>default</AllowMulticast>
            <MaxMessageSize>65500B</MaxMessageSize>
        </General>
        <Discovery>
            <EnableTopicDiscoveryEndpoints>true</EnableTopicDiscoveryEndpoints>
            <!-- Unicast discovery as a backstop: a direct cable or a dumb
                 switch may not carry multicast reliably. Listing both ends on
                 both machines keeps this file machine-independent (a peer
                 entry for yourself is harmless). ParticipantIndex=auto lets
                 peers find each other without a fixed port assignment. -->
            <ParticipantIndex>auto</ParticipantIndex>
            <!-- REQUIRED alongside <Peers>. Unicast discovery makes every
                 participant individually addressable, so each one claims an
                 index (= its own port pair) out of 0..MaxAutoParticipantIndex.
                 That default is 9, i.e. TEN participants per host per domain —
                 and stretch_nav2's navigation.launch.py alone starts ~20
                 processes. Past the tenth every node dies at startup with

                   Failed to find a free participant index for domain 0
                   rmw_create_node: failed to create domain, error Error

                 which looks like a Cyclone/robot incompatibility but is only
                 this cap. Multicast SPDP (no <Peers>) has no such limit.
                 Both ends need the value; keep it above the participant count
                 of the busiest machine. -->
            <MaxAutoParticipantIndex>60</MaxAutoParticipantIndex>
            <Peers>
                <Peer address="192.168.100.1" />
                <Peer address="192.168.100.2" />
            </Peers>
        </Discovery>
        <Internal>
            <!-- Sized for image traffic. The stock kernel limit is 208 kB,
                 smaller than a single 2.76 MB frame, which shows up as
                 stuttering or vanishing images rather than an error. Needs
                 net.core.rmem_max raised on the HOST (containers run with
                 network_mode: host, so the host value is what applies)
                 see docker/vlm/README.md. -->
            <SocketReceiveBufferSize min="10MB" />
            <Watermarks>
                <!-- 500 kB (the default in docker/vlm/cyclonedds.xml) throttles
                     the writer hard when samples are multi-MB. -->
                <WhcHigh>4MB</WhcHigh>
            </Watermarks>
        </Internal>
    </Domain>
</CycloneDDS>
