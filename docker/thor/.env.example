# Copy to docker/thor/.env (gitignored) and fill in:
#
#   cp docker/thor/.env.example docker/thor/.env
#   sed -i "s/^UID=.*/UID=$(id -u)/; s/^GID=.*/GID=$(id -g)/" docker/thor/.env
#
# Relative paths resolve from docker/thor/compose.yaml.

COMPOSE_PROJECT_NAME=stretch_thor

# --- container user (REQUIRED) ----------------------------------------------
# The images build a user with these ids and bind-mount the checkout; wrong ids
# and nothing can write outputs/. `UID` is a bash built-in compose never sees,
# so it has to be written here.
UID=1000
GID=1000

# --- the Thor's base image (verify on YOUR unit, OSG docs/THOR.md) ----------
BASE_IMAGE=nvcr.io/nvidia/pytorch:25.10-py3
CUDA_ARCH=11.0
TORCH_INDEX_URL=
WITH_BLIP2=1

# --- ROS 2 / DDS: must match the robot (docker/deploy) ----------------------
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# The one DDS file both ends mount (docker/cyclonedds-eth.xml), pinned to the
# wired robot <-> Thor link: Thor 192.168.100.2, robot 192.168.100.1.
CYCLONEDDS_CONFIG=../cyclonedds-eth.xml
CYCLONEDDS_URI=/etc/cyclonedds-eth.xml
# THIS machine's wired NIC (`ip -brief addr`). The Thor's is enP2p1s0.
CYCLONEDDS_IFACE=enP2p1s0
# The DDS file asks for a 10 MB socket receive buffer (camera frames are
# multi-MB). With host networking the HOST's limit applies; the stock 208 kB
# shows up as stuttering or vanishing images, not as an error. On the Thor AND
# the robot, once:
#   echo 'net.core.rmem_max=134217728' | sudo tee /etc/sysctl.d/60-cyclonedds.conf
#   sudo sysctl --system

# --- control panel (control_panel/, the `panel` service) --------------------
# The port phones and tablets open: http://<thor-ip>:8080
PANEL_PORT=8080

# --- GUI tools (the `rviz` service) -----------------------------------------
DISPLAY=:1

# NVIDIA_API_KEY (the VLM inspection) is NOT kept here. Export it from the key
# file outside the repo before `up`:  source ~/.nvidia_api.env
