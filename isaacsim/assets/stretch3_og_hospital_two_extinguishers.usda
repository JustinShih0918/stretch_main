#usda 1.0
(
    doc = """The hospital with TWO fire extinguishers, for the multi-instance demo
(scripts/extinguisher_demo/README.md, "Two extinguishers").

Everything in stretch3_og_hospital_extinguisher.usda, plus a second extinguisher
2.1 m west of the first along the same lobby wall, beside the supply cart, in
"good" condition. The first keeps its `condition` variant (switched by
open_extinguisher.py's control file); either can be moved while Isaac plays
with move_extinguisher.sh."""
    customLayerData = {
        dictionary cameraSettings = {
            string boundCamera = "/World/stretch3/base_link/follow_camera"
        }
    }
    defaultPrim = "World"
    endTimeCode = 1000000
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./stretch3_og_hospital_extinguisher.usda@
    ]
    timeCodesPerSecond = 60
    upAxis = "Z"
)

over "World"
{
    def Xform "FireExtinguisher2" (
        prepend references = @./fire_extinguisher_inspect.usda@
        variants = {
            string condition = "good"
        }
    )
    {
        double3 xformOp:translate = (-9.6, 5.12, 0)
        double3 xformOp:rotateXYZ = (0, 0, 100)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
